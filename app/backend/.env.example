# Copy to `.env` for local development. The real values must NOT be committed —
# `.env` is gitignored and CI secret-scans it (see scripts/secret-scan.py).

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# ELEVATED key: this server-side key bypasses Row Level Security by design, so
# treat any exposure as a full data breach. Prefer the newer `sb_secret_...` key
# over the legacy `service_role` JWT, and read the rotation playbook in the
# `supabase-admin` skill before changing it — every consumer (this env, Render,
# CI) has to be updated before the old key is disabled.
SUPABASE_SERVICE_KEY=

# Port the API listens on locally (defaults to 3001 in src/index.ts).
PORT=3001
